NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jarvis_db?schema=public"

# Express Session
SESSION_SECRET="your-super-secure-session-secret-change-in-production"

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID="YOUR_DISCORD_CLIENT_ID"
DISCORD_CLIENT_SECRET="YOUR_DISCORD_CLIENT_SECRET"
DISCORD_REDIRECT_URI="http://localhost:5000/api/auth/discord/callback"

# Discord Bot Token
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"
DISCORD_GUILD_ID="YOUR_DISCORD_GUILD_ID"
DISCORD_ADMIN_ROLE_ID="YOUR_DISCORD_ADMIN_ROLE_ID"

# Discord Channel IDs for Logging
DISCORD_PAYMENT_LOG_CHANNEL_ID="YOUR_PAYMENT_LOG_CHANNEL_ID"
DISCORD_PAYMENT_TICKET_CHANNEL_ID="YOUR_PAYMENT_TICKET_CHANNEL_ID"
DISCORD_BILLING_LOG_CHANNEL_ID="YOUR_BILLING_LOG_CHANNEL_ID"
DISCORD_SERVER_LOG_CHANNEL_ID="YOUR_SERVER_LOG_CHANNEL_ID"
DISCORD_SUPPORT_CHANNEL_ID="YOUR_SUPPORT_CHANNEL_ID"
DISCORD_SYSTEM_LOG_CHANNEL_ID="YOUR_SYSTEM_LOG_CHANNEL_ID"

# Frontend URLs
FRONTEND_URL="http://localhost:5173"
FRONTEND_DASHBOARD_URL="http://localhost:5173/dashboard"

# UPI Merchant Info
MERCHANT_UPI_ID="jarvishosting@upi"
MERCHANT_NAME="JARVIS Hosting"
